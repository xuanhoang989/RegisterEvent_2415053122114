<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MÀN HÌNH ĐĂNG KÝ"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Ô nhập Họ tên -->
        <EditText
            android:id="@+id/edtHoTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập họ và tên"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <!-- Ô nhập Email -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp" />

        <!-- Radio button giới tính -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giới tính:"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGioiTinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbNam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nam"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbNu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nữ"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbKhac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khác" />
        </RadioGroup>

        <!-- Checkbox Mạng xã hội -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mạng xã hội sử dụng:"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbFacebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Facebook" />

        <CheckBox
            android:id="@+id/cbZalo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zalo" />

        <CheckBox
            android:id="@+id/cbTiktok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TikTok"
            android:layout_marginBottom="24dp" />

        <!-- Button đăng ký -->
        <Button
            android:id="@+id/btnDangKy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng ký" />

    </LinearLayout>
</ScrollView>